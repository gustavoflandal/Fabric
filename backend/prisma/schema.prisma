// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// USUÁRIOS E SEGURANÇA
// ============================================

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  name                String
  active              Boolean   @default(true)
  lastLogin           DateTime?
  // ✅ Fase 2 item 2.4 do cronograma: bloqueio de conta por tentativas de
  // login falhas (nao existia nenhum controle por conta, so rate limit por IP)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  roles                   UserRole[]
  auditLogs               AuditLog[]
  productionPointings     ProductionPointing[]
  stockMovements          StockMovement[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  countingAssignments     CountingAssignment[]
  refreshTokens           RefreshToken[]

  // Contagem de Estoque
  countingPlansCreated CountingPlan[]    @relation("CountingPlanCreator")
  sessionsAssigned     CountingSession[] @relation("SessionAssignedTo")
  sessionsCompleted    CountingSession[] @relation("SessionCompletedBy")
  itemsCounted         CountingItem[]    @relation("ItemCountedBy")
  itemsRecounted       CountingItem[]    @relation("ItemRecountedBy")

  // ✅ Fase 4 item 4.5 do cronograma: FKs de auditoria (antes eram String
  // solta, sem integridade referencial nenhuma)
  productionOrdersCreated    ProductionOrder[]   @relation("ProductionOrderCreator")
  purchaseQuotationsCreated  PurchaseQuotation[] @relation("PurchaseQuotationCreator")
  purchaseQuotationsApproved PurchaseQuotation[] @relation("PurchaseQuotationApprover")
  purchaseOrdersCreated      PurchaseOrder[]     @relation("PurchaseOrderCreator")
  purchaseOrdersApproved     PurchaseOrder[]     @relation("PurchaseOrderApprover")
  purchaseReceiptsReceived   PurchaseReceipt[]   @relation("PurchaseReceiptReceiver")

  // F4.1/F4.4 do plano do WMS: tarefas de armazem atribuidas e enderecamentos
  // de recebimento executados por este usuario.
  warehouseTasksAssigned WarehouseTask[]  @relation("WarehouseTaskAssignee")
  receiptPutaways        ReceiptPutaway[] @relation("ReceiptPutawayUser")

  @@map("users")
}

// ✅ Fase 2 item 2.3 do cronograma: refresh tokens persistidos para permitir
// revogacao/rotacao real. Antes o refresh token era puramente stateless (so
// a assinatura JWT era checada) - logout nao invalidava nada, e um token
// roubado continuava valido pelos 7 dias inteiros inteiros. So o `jti` e
// guardado (nao o token inteiro): ele e um identificador aleatorio sem valor
// sozinho, quem prova posse e a assinatura JWT que so o servidor sabe validar.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  jti       String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Role {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  active      Boolean @default(true)

  users             UserRole[]
  permissions       RolePermission[]
  notificationRules NotificationRule[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  resource    String
  action      String
  description String?

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id          String  @id @default(uuid())
  userId      String?
  action      String  @db.VarChar(100)
  resource    String  @db.VarChar(100)
  resourceId  String?
  description String? @db.Text

  // Dados da requisição HTTP
  ipAddress  String? @db.VarChar(45)
  userAgent  String? @db.Text
  method     String? @db.VarChar(10)
  endpoint   String? @db.VarChar(500)
  statusCode Int?

  // Dados de auditoria
  requestBody  Json?
  responseBody Json?
  oldValues    Json?
  newValues    Json?
  errorMessage String? @db.Text
  durationMs   Int?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([resource])
  @@index([resourceId])
  @@index([resource, resourceId, createdAt])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// CADASTROS BÁSICOS
// ============================================

model WorkCenter {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  type        String
  capacity    Float?
  efficiency  Float    @default(1.0)
  costPerHour Float?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  operations           RoutingOperation[]
  productionOperations ProductionOrderOperation[]
  productionPointings  ProductionPointing[]

  @@map("work_centers")
}

model UnitOfMeasure {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  type      String // length, weight, volume, quantity, time
  symbol    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
  bomItems BOMItem[]

  @@map("units_of_measure")
}

model Supplier {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  legalName    String?
  document     String?  @unique
  email        String?
  phone        String?
  address      String?
  city         String?
  state        String?
  zipCode      String?
  country      String   @default("BR")
  paymentTerms String?
  leadTime     Int?
  rating       Float?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quotations     PurchaseQuotation[]
  purchaseOrders PurchaseOrder[]
  // Fase 5 do WMS: o fornecedor de um lote. Opcional do lado do lote (nem todo
  // lote vem de compra), por isso aqui e uma lista que pode ficar vazia.
  lots           Lot[]

  @@map("suppliers")
}

model Customer {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  legalName    String?
  document     String?  @unique
  email        String?
  phone        String?
  address      String?
  city         String?
  state        String?
  zipCode      String?
  country      String   @default("BR")
  paymentTerms String?
  creditLimit  Float?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("customers")
}

// ============================================
// ENGENHARIA DE PRODUTOS
// ============================================

model Product {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String? @db.Text
  type        String
  unitId      String
  categoryId  String?

  leadTime Int    @default(0)
  lotSize  Float?

  minStock     Float  @default(0)
  maxStock     Float?
  safetyStock  Float  @default(0)
  reorderPoint Float?

  standardCost Float?
  lastCost     Float?
  averageCost  Float?

  // --- Dados para Armazenagem (WMS) ---------------------------------------
  // F0.9 do plano do WMS (docs/fase-2026-09-modernizacao/WMS_IMPLEMENTATION_ANALYSIS.md)
  // e secao 3.2 de 04_ARQUITETURA_MODULAR_LICENCIAMENTO.md: campos OPCIONAIS na
  // propria entidade compartilhada, nunca uma tabela ProductWMS paralela. Um
  // cliente so-PCP nunca preenche nada disso e nao e impactado (colunas nullable).
  // Alimentam a regra de alocacao (StorageRule, F4.6) e a checagem de capacidade
  // da posicao. Unidades: weight em kg; width/height/depth em metros;
  // volume em m3 (derivado de width*height*depth em product.service quando as
  // tres dimensoes existem e volume nao foi informado explicitamente).
  weight           Float? // peso unitario (kg)
  width            Float? // largura (m)
  height           Float? // altura (m)
  depth            Float? // profundidade (m)
  volume           Float? // volume unitario (m3) - derivado ou informado
  packagingType    String? // tipo de embalagem (CAIXA, PALLET, FARDO, ...)
  maxStackQty      Int? // quantas unidades podem ser empilhadas
  segregationGroup String? // grupo de incompatibilidade de armazenagem

  // --- Controle de lote (WMS Fase 5) --------------------------------------
  // Fase 5 do plano do WMS: lote e OPT-IN POR PRODUTO, nao universal. Um
  // parafuso nao tem lote; um lote de tinta tem. Toda a mecanica da fase
  // (captura obrigatoria de `lotNumber` na conferencia do recebimento, FEFO no
  // picking, bloqueio de saida de lote vencido, terceira dimensao do saldo por
  // posicao) SO se aplica quando esta flag e `true`.
  //
  // `false` por default e a disciplina que todas as fases anteriores seguiram
  // para MODULO ("sem WMS licenciado, comportamento identico ao de hoje"),
  // aplicada aqui a PRODUTO: um produto sem lote controlado percorre todos os
  // fluxos exatamente como antes desta fase, sem uma linha de comportamento
  // diferente.
  lotTracked       Boolean @default(false)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit     UnitOfMeasure    @relation(fields: [unitId], references: [id])
  category ProductCategory? @relation(fields: [categoryId], references: [id])

  boms                  BOM[]
  bomItems              BOMItem[]
  routings              Routing[]
  productionOrders      ProductionOrder[]
  stockMovements        StockMovement[]
  quotationItems        PurchaseQuotationItem[]
  purchaseOrderItems    PurchaseOrderItem[]
  receiptItems          PurchaseReceiptItem[]
  countingItems         CountingItem[]
  countingPlanProducts  CountingPlanProduct[]
  stockBalance          StockBalance?
  stockPositionBalances StockPositionBalance[]
  warehouseTasks        WarehouseTask[]
  storageRules          StorageRule[]
  lots                  Lot[]

  @@index([type])
  @@index([active])
  @@map("products")
}

// Fase 5 do plano do WMS (WMS_IMPLEMENTATION_ANALYSIS.md, secao 5, Fase 5) —
// LOTE: a terceira dimensao do saldo, depois de produto (Fase 1) e posicao
// (Fase 1/2).
//
// ESCOPO DA UNICIDADE: `@@unique([productId, lotNumber])`, nao `lotNumber`
// global. Numero de lote e emitido pelo FABRICANTE, nao pelo Fabric — dois
// fornecedores diferentes podem perfeitamente emitir "L2026-001" para produtos
// diferentes, e um unique global recusaria o segundo recebimento legitimo.
//
// SEM CAMPO DE STATUS, deliberadamente. Nao existe `ACTIVE`/`BLOCKED`/`EXPIRED`
// aqui: vencimento e DERIVADO de `expiresAt < now()` no momento exato da
// operacao, nunca um estado armazenado. Um estado armazenado precisaria de um
// job para transiciona-lo e ficaria dessincronizado entre a virada do dia e a
// proxima execucao — a data ja e a verdade, e derivar dela e a unica leitura
// que nunca mente. Bloqueio administrativo/quarentena de lote NAO faz parte
// desta fase (registrado no plano como fora de escopo).
//
// `supplierId` e OPCIONAL: um lote pode nascer de um recebimento de compra (e
// entao herda o fornecedor do pedido) ou de producao propria/ajuste, que nao
// tem fornecedor nenhum.
model Lot {
  id             String    @id @default(uuid())
  productId      String
  lotNumber      String
  manufacturedAt DateTime?
  expiresAt      DateTime?
  supplierId     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // `Restrict` EXPLICITO nos dois lados, mesmo padrao de StockPositionBalance e
  // StockMovement: apagar produto ou fornecedor nao pode evaporar a
  // rastreabilidade de um lote que ja circulou no armazem.
  product  Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  positionBalances StockPositionBalance[]
  movements        StockMovement[]
  warehouseTasks   WarehouseTask[]

  @@unique([productId, lotNumber])
  // O indice do FEFO: `planPickingFromPositions()` ordena os candidatos por
  // `expiresAt` ascendente.
  @@index([expiresAt])
  @@index([supplierId])
  @@map("lots")
}

// Saldo de estoque persistido por produto. Antes, o saldo era somado em memoria
// a partir de todo o historico de stock_movements a cada consulta - alem de
// caro, nao existia uma linha para travar (SELECT ... FOR UPDATE) e evitar que
// duas movimentacoes concorrentes do mesmo produto lessem o mesmo saldo "fantasma"
// e ambas decidissem que havia estoque suficiente. Ver Fase 1 do cronograma
// (docs/fase-2026-09-modernizacao/02_CRONOGRAMA_IMPLEMENTACOES.md, itens 1.1/1.2).
model StockBalance {
  id        String   @id @default(uuid())
  productId String   @unique
  quantity  Float    @default(0)
  version   Int      @default(0) // lock otimista para leituras fora de transacao
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])

  @@map("stock_balances")
}

// F1.1 do plano do WMS (docs/fase-2026-09-modernizacao/WMS_IMPLEMENTATION_ANALYSIS.md,
// secao 5, Fase 1) - o nucleo do WMS: saldo por PRODUTO x POSICAO.
//
// Decisao D1 (secao 4.4): `stock_balances` (agregado por produto) PERMANECE e
// continua sendo a fonte consumida por MRP, dashboards, notificacoes e
// relatorios. Esta tabela e a dimensao nova; o agregado passa a ser o roll-up,
// mantido na MESMA transacao por stock.service.ts::applyMovement().
//
// Decisao D2 (secao 4.4): quantidade nasce `Decimal(18,4)`, NAO `Float`. O item
// 4.1 do cronograma (Float -> Decimal) foi adiado com justificativa; tabela nova
// nao deve herdar a divida. Consequencia pratica: `Prisma.Decimal` nao e um
// number JS - o service faz aritmetica com Decimal e os endpoints novos
// serializam como STRING (ver stock-position.service.ts).
//
// FKs SEM `onDelete: Cascade` de proposito, nos DOIS lados: apagar produto ou
// posicao nao pode evaporar saldo silenciosamente. O comportamento default do
// Prisma para relacao obrigatoria e RESTRICT, ou seja, a exclusao e BARRADA
// enquanto houver saldo - que e exatamente o desejado. Note que
// storage_positions.structureId TEM cascade (estrutura -> posicao); com esta FK
// no caminho, apagar uma estrutura com saldo passa a falhar, e
// storage-position.service.ts traduz isso em AppError legivel.
model StockPositionBalance {
  id                String   @id @default(uuid())
  productId         String
  storagePositionId String
  // Fase 5 — A TERCEIRA DIMENSAO. NULL para produto sem `lotTracked` (e para
  // todo saldo que ja existia antes desta fase, que a migration deixa
  // intocado): a coluna nao muda nada para quem nao controla lote.
  lotId             String?
  quantity          Decimal  @default(0) @db.Decimal(18, 4)
  version           Int      @default(0) // lock otimista, mesmo padrao de StockBalance
  updatedAt         DateTime @updatedAt

  product         Product         @relation(fields: [productId], references: [id])
  storagePosition StoragePosition @relation(fields: [storagePositionId], references: [id])
  // `Restrict` EXPLICITO — o default do Prisma para relacao OPCIONAL seria
  // `SetNull`, que aqui seria destrutivo: apagar um lote transformaria saldo
  // rastreado em saldo anonimo na mesma posicao, silenciosamente, e ainda
  // colidiria com a linha sem lote que talvez ja exista ali.
  lot             Lot?            @relation(fields: [lotId], references: [id], onDelete: Restrict)

  // Fase 5 — a chave passou de (produto, posicao) para (produto, posicao, lote).
  // No MySQL, NULL e DISTINTO num indice unico: produto sem lote continua com
  // exatamente UMA linha por posicao (todas com `lotId` NULL, que o indice nao
  // conflita), e produto com lote ganha uma linha por lote naquela posicao. E a
  // mesma tecnica ja usada em `CountingItem` (Fase 3) e no par
  // `fromPositionId`/`toPositionId` de `StockMovement` (Fase 2).
  //
  // CONSEQUENCIA que precisa ficar registrada: por NULL ser distinto, o banco
  // deixa de garantir sozinho que existe no maximo UMA linha sem lote por
  // (produto, posicao). Quem garante isso e o lock de `stock_balances` que
  // `applyMovement()` adquire ANTES de tocar em qualquer linha desta tabela —
  // todas as escritas de saldo de um produto sao serializadas por ele, entao
  // duas insercoes concorrentes da mesma linha sem lote nao podem acontecer.
  // Mexer nessa ordem de lock reabre este buraco; ver a nota em `applyMovement`.
  @@unique([productId, storagePositionId, lotId])
  // Um indice dedicado por `productId` NAO e declarado: no MySQL/InnoDB o indice
  // unico composto acima ja atende qualquer busca por `productId` (e a coluna
  // mais a esquerda). Criar um segundo indice com o mesmo prefixo so adicionaria
  // custo de escrita numa tabela que e escrita a cada movimentacao, sem ganho de
  // leitura. O indice por `storagePositionId` abaixo, esse sim, e necessario -
  // nao ha prefixo que o cubra ("o que tem nesta posicao?" e "quais posicoes
  // deste armazem estao ocupadas?").
  @@index([storagePositionId])
  // "Onde esta este lote?" — a pergunta do recall e do descarte de vencido. Nao
  // ha prefixo do unico composto que a cubra (`lotId` e a coluna mais a
  // direita).
  @@index([lotId])
  @@map("stock_position_balances")
}

model ProductCategory {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  parentId    String?

  parent   ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryHierarchy")
  products Product[]
  // F4.6: regra de armazenagem por CATEGORIA (ver `StorageRule`).
  storageRules StorageRule[]

  @@map("product_categories")
}

model BOM {
  id          String    @id @default(uuid())
  productId   String
  version     Int       @default(1)
  description String?
  validFrom   DateTime  @default(now())
  validTo     DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  product Product   @relation(fields: [productId], references: [id])
  items   BOMItem[]

  @@unique([productId, version])
  @@index([productId, active])
  @@map("boms")
}

model BOMItem {
  id          String  @id @default(uuid())
  bomId       String
  componentId String
  quantity    Float
  unitId      String
  scrapFactor Float   @default(0)
  sequence    Int
  notes       String?

  bom       BOM           @relation(fields: [bomId], references: [id], onDelete: Cascade)
  component Product       @relation(fields: [componentId], references: [id])
  unit      UnitOfMeasure @relation(fields: [unitId], references: [id])

  @@unique([bomId, componentId])
  @@unique([bomId, sequence])
  @@index([bomId])
  @@map("bom_items")
}

model Routing {
  id          String    @id @default(uuid())
  productId   String
  version     Int       @default(1)
  description String?
  validFrom   DateTime  @default(now())
  validTo     DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  product    Product            @relation(fields: [productId], references: [id])
  operations RoutingOperation[]

  @@unique([productId, version])
  @@index([productId, active])
  @@map("routings")
}

model RoutingOperation {
  id           String  @id @default(uuid())
  routingId    String
  sequence     Int
  workCenterId String
  description  String
  setupTime    Float
  runTime      Float
  queueTime    Float   @default(0)
  moveTime     Float   @default(0)
  notes        String?

  routing    Routing    @relation(fields: [routingId], references: [id], onDelete: Cascade)
  workCenter WorkCenter @relation(fields: [workCenterId], references: [id])

  @@unique([routingId, sequence])
  @@index([routingId])
  @@map("routing_operations")
}

// ============================================
// PRODUÇÃO
// ============================================

model ProductionOrder {
  id          String @id @default(uuid())
  orderNumber String @unique
  productId   String
  quantity    Float
  producedQty Float  @default(0)
  scrapQty    Float  @default(0)
  priority    Int    @default(5)
  status      String @default("PLANNED")
  // ✅ Fase 4 item 4.2 do cronograma: lock otimista (evita "lost update" quando
  // dois usuarios editam a mesma ordem em telas abertas ao mesmo tempo -
  // diferente dos locks pessimistas ja adicionados nas Fases 1/3 para as
  // race conditions especificas ja encontradas, este cobre o caso geral de
  // edicao concorrente via formulario)
  version     Int    @default(0)

  scheduledStart DateTime
  scheduledEnd   DateTime
  actualStart    DateTime?
  actualEnd      DateTime?

  plannedCost Float?
  actualCost  Float?

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  product    Product                    @relation(fields: [productId], references: [id])
  creator    User                       @relation("ProductionOrderCreator", fields: [createdBy], references: [id])
  operations ProductionOrderOperation[]
  pointings  ProductionPointing[]

  @@index([status])
  @@index([scheduledStart])
  @@index([status, scheduledStart])
  @@index([productId])
  @@index([createdBy])
  @@map("production_orders")
}

model ProductionOrderOperation {
  id                String @id @default(uuid())
  productionOrderId String
  sequence          Int
  workCenterId      String
  description       String
  // ✅ Fase 4 item 4.2: lock otimista (ver comentário em ProductionOrder)
  version           Int    @default(0)

  plannedQty   Float
  completedQty Float @default(0)
  scrapQty     Float @default(0)

  setupTime        Float
  runTime          Float
  totalPlannedTime Float
  actualTime       Float @default(0)

  status         String    @default("PENDING")
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  actualStart    DateTime?
  actualEnd      DateTime?

  productionOrder ProductionOrder      @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  workCenter      WorkCenter           @relation(fields: [workCenterId], references: [id])
  pointings       ProductionPointing[]

  @@index([productionOrderId])
  @@index([workCenterId])
  @@index([status])
  @@map("production_order_operations")
}

model ProductionPointing {
  id                String @id @default(uuid())
  productionOrderId String
  operationId       String
  workCenterId      String
  userId            String

  quantityGood  Float
  quantityScrap Float @default(0)

  setupTime Float @default(0)
  runTime   Float

  startTime DateTime
  endTime   DateTime

  notes     String?
  createdAt DateTime @default(now())

  productionOrder ProductionOrder          @relation(fields: [productionOrderId], references: [id])
  operation       ProductionOrderOperation @relation(fields: [operationId], references: [id])
  workCenter      WorkCenter               @relation(fields: [workCenterId], references: [id])
  user            User                     @relation(fields: [userId], references: [id])

  @@index([productionOrderId])
  @@index([operationId])
  @@index([workCenterId])
  @@index([userId])
  @@index([startTime])
  @@index([operationId, startTime])
  @@index([userId, startTime])
  @@map("production_pointings")
}

// ============================================
// ESTOQUE
// ============================================

// F2.2 do plano do WMS (decisao D4): `type` deixou de ser `String` livre e
// virou ENUM. Antes, nada no banco impedia gravar "in", "SAIDA" ou um typo -
// e o calculo de saldo legado (mrp.service, notification-detector,
// counting-session) simplesmente ignorava ou somava errado o valor invalido.
// Com o enum, o banco recusa; com `StockMovementType` gerado pelo Prisma, o
// TypeScript recusa antes ainda.
//
// TRANSFER e o valor NOVO desta fase (F2.3): transferencia interna entre dois
// enderecos. Ele e o unico tipo que NAO altera o saldo agregado
// (`stock_balances`) - so muda ONDE o material esta, nao QUANTO existe. Todo
// codigo que soma movimentacoes para derivar saldo precisa exclui-lo
// explicitamente (ver os `type: { in: [...] }` em mrp.service.ts,
// notification-detector.service.ts e counting-session.service.ts).
enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
}

model StockMovement {
  id                String            @id @default(uuid())
  productId         String
  type              StockMovementType
  quantity          Float
  reason            String
  reference         String? // ID da OP, Pedido, etc (sem FK - campo polimorfico, ver referenceType)
  referenceType     String? // PRODUCTION, PURCHASE, ADJUSTMENT, MANUAL, COUNTING
  countingSessionId String? // FK dedicada, preenchida apenas quando referenceType = COUNTING
  userId            String
  notes             String?
  // F2.1 do plano do WMS - o par ORIGEM/DESTINO que substituiu o campo unico
  // `positionId` da Fase 1 (migration `20260902100000_fase2_wms_movimentacao_transferencia`,
  // que reaproveitou os valores gravados em vez de descarta-los).
  //
  // Semantica, VALIDADA em stock.service.ts::applyMovement() com AppError:
  //   IN         -> so `toPositionId`   (onde a quantidade entrou)
  //   OUT        -> so `fromPositionId` (de onde a quantidade saiu)
  //   TRANSFER   -> os DOIS obrigatorios e diferentes entre si
  //   ADJUSTMENT -> UM dos dois (to = sobra encontrada, from = quebra)
  // Os dois NULL = movimentacao nao enderecada. Continua sendo 100% do fluxo
  // legado (recebimento, contagem, reserva de producao, entrada/saida manual) e
  // funciona exatamente como antes - a dimensao de endereco e aditiva.
  //
  // O par nao e redundante com `type`: e ele que permite que UMA linha de
  // movimentacao represente a transferencia inteira (debito na origem +
  // credito no destino na mesma transacao), em vez de um par OUT/IN que
  // poderia ficar orfao pela metade.
  fromPositionId    String?
  toPositionId      String?
  // Fase 5 — LOTE. Campo UNICO, e nao um par `from`/`to` como as posicoes: um
  // lote nao "vai de A para B". A quantidade que muda de saldo e sempre do
  // MESMO lote, inclusive num `TRANSFER` (mudar de endereco nao reetiqueta o
  // material), entao uma coluna basta — e o mesmo desenho que `positionId`
  // tinha na Fase 1, antes de F2.1 precisar distinguir origem de destino.
  //
  // NULL para produto sem `lotTracked` e para toda movimentacao anterior a esta
  // fase.
  lotId             String?
  createdAt         DateTime          @default(now())

  product         Product          @relation(fields: [productId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  countingSession CountingSession? @relation("CountingAdjustments", fields: [countingSessionId], references: [id])
  // `Restrict` EXPLICITO nos DOIS lados - o default do Prisma para relacao
  // OPCIONAL seria `SetNull`, que NAO serve aqui: historico de movimentacao e
  // trilha de auditoria, e apagar uma posicao nao pode zerar silenciosamente o
  // endereco onde o material esteve. A forma correta de aposentar um endereco
  // que ja foi usado e `blocked = true`, nao DELETE - storage-position.service.ts
  // traduz a violacao de FK em AppError explicando isso. (Motivo herdado
  // integralmente do `positionId` da Fase 1; F2.1 so o duplicou para origem e
  // destino.)
  fromPosition    StoragePosition? @relation("StockMovementFrom", fields: [fromPositionId], references: [id], onDelete: Restrict)
  toPosition      StoragePosition? @relation("StockMovementTo", fields: [toPositionId], references: [id], onDelete: Restrict)
  // `Restrict` explicito pelo mesmo motivo das posicoes: o historico e trilha de
  // auditoria e apagar um lote nao pode zerar silenciosamente qual lote saiu.
  lot             Lot?             @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([productId, createdAt])
  @@index([type])
  @@index([createdAt])
  @@index([reference])
  @@index([referenceType, reference])
  // Um indice por coluna, e nao um composto: o historico por posicao (F2.4)
  // pergunta "esta posicao foi origem OU destino", que no MySQL vira um OR
  // resolvido por index merge dos dois indices - um composto
  // (fromPositionId, toPositionId) nao atenderia a segunda metade da condicao.
  @@index([fromPositionId])
  @@index([toPositionId])
  // Fase 5 — "todo o historico deste lote", a consulta de recall.
  @@index([lotId])
  @@map("stock_movements")
}

// ============================================
// COMPRAS
// ============================================

model PurchaseQuotation {
  id              String    @id @default(uuid())
  quotationNumber String    @unique
  supplierId      String
  requestDate     DateTime  @default(now())
  dueDate         DateTime
  status          String    @default("PENDING") // PENDING, SENT, RECEIVED, APPROVED, REJECTED, EXPIRED
  notes           String?   @db.Text
  totalValue      Float     @default(0)
  createdBy       String
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  supplier       Supplier                @relation(fields: [supplierId], references: [id])
  creator        User                    @relation("PurchaseQuotationCreator", fields: [createdBy], references: [id])
  approver       User?                   @relation("PurchaseQuotationApprover", fields: [approvedBy], references: [id])
  items          PurchaseQuotationItem[]
  purchaseOrders PurchaseOrder[]

  @@index([supplierId])
  @@index([status])
  @@index([requestDate])
  @@index([createdBy])
  @@map("purchase_quotations")
}

model PurchaseQuotationItem {
  id           String  @id @default(uuid())
  quotationId  String
  productId    String
  quantity     Float
  unitPrice    Float
  discount     Float   @default(0)
  totalPrice   Float
  deliveryDays Int?
  notes        String?

  quotation PurchaseQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product           @relation(fields: [productId], references: [id])

  @@index([quotationId])
  @@index([productId])
  @@map("purchase_quotation_items")
}

model PurchaseOrder {
  id            String    @id @default(uuid())
  orderNumber   String    @unique
  supplierId    String
  quotationId   String?
  orderDate     DateTime  @default(now())
  expectedDate  DateTime
  receivedDate  DateTime?
  status        String    @default("PENDING") // PENDING, CONFIRMED, PARTIAL, RECEIVED, CANCELLED
  paymentTerms  String?
  paymentMethod String?
  shippingCost  Float     @default(0)
  discount      Float     @default(0)
  totalValue    Float
  notes         String?   @db.Text
  createdBy     String
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  quotation PurchaseQuotation?  @relation(fields: [quotationId], references: [id])
  creator   User                @relation("PurchaseOrderCreator", fields: [createdBy], references: [id])
  approver  User?               @relation("PurchaseOrderApprover", fields: [approvedBy], references: [id])
  items     PurchaseOrderItem[]
  receipts  PurchaseReceipt[]

  @@index([supplierId])
  @@index([quotationId])
  @@index([status])
  @@index([orderDate])
  @@index([createdBy])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String
  quantity    Float
  receivedQty Float   @default(0)
  unitPrice   Float
  discount    Float   @default(0)
  totalPrice  Float
  notes       String?
  // ✅ Fase 4 item 4.2: lock otimista (ver comentário em ProductionOrder) -
  // protege receivedQty contra "lost update" quando dois recebimentos do
  // mesmo item de pedido são processados perto um do outro sem estarem
  // dentro da mesma transação
  version     Int     @default(0)

  order        PurchaseOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product               @relation(fields: [productId], references: [id])
  receiptItems PurchaseReceiptItem[]

  @@index([orderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model PurchaseReceipt {
  id            String   @id @default(uuid())
  receiptNumber String   @unique
  orderId       String
  receiptDate   DateTime @default(now())
  receivedBy    String
  notes         String?  @db.Text
  // F4.2 do plano do WMS: `CONFERIDO` e o estado INTERMEDIARIO novo - quantidade
  // ja conferida (os itens existem com `acceptedQty`), material ainda NAO
  // enderecado, logo ainda NAO entrou no saldo. E o status inicial de todo
  // recebimento criado com WMS licenciado; ele avanca para `COMPLETED` quando a
  // ultima `ReceiptPutaway` cobre o `acceptedQty` de todos os itens
  // (warehouse-task.service.ts::completePutaway).
  //
  // Continua `String` livre, e nao enum, deliberadamente: e o padrao do resto do
  // modulo de compras (PurchaseOrder.status, PurchaseQuotation.status) e migrar
  // um dos tres para enum criaria inconsistencia pior do que a que resolve.
  // `PENDING` continua sendo o valor de quem nasce SEM WMS (fluxo linear, o
  // estoque ja entrou na criacao) - nada no caminho sem WMS mudou.
  // `APPROVED`/`REJECTED` seguem vestigiais: nunca existiu fluxo de aprovacao.
  status        String   @default("PENDING") // PENDING, CONFERIDO, COMPLETED, APPROVED, REJECTED
  createdAt     DateTime @default(now())

  order    PurchaseOrder         @relation(fields: [orderId], references: [id])
  receiver User                  @relation("PurchaseReceiptReceiver", fields: [receivedBy], references: [id])
  items    PurchaseReceiptItem[]

  @@index([orderId])
  @@index([receiptDate])
  @@index([receivedBy])
  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id          String  @id @default(uuid())
  receiptId   String
  orderItemId String
  productId   String
  quantity    Float
  acceptedQty Float
  rejectedQty Float   @default(0)
  notes       String?

  // --- Lote capturado na CONFERENCIA (WMS Fase 5) --------------------------
  // Os tres campos sao preenchidos no MESMO momento e pelo MESMO formulario
  // conceitual que `acceptedQty`: a conferencia e quando alguem tem a caixa na
  // mao e le a etiqueta do fabricante. Capturar depois (na alocacao) obrigaria
  // o operador a reabrir o palete.
  //
  // Sao dados do RECEBIMENTO, nao o lote em si: o `Lot` (entidade com saldo
  // pendurado) so nasce na conclusao da tarefa de ALOCACAO, quando o material
  // de fato entra no estoque enderecado. Ate la isto e o que foi LIDO na doca.
  //
  // Obrigatoriedade de `lotNumber` e por PRODUTO (`Product.lotTracked`),
  // validada em purchase-receipt.service.ts::create() com AppError — o banco
  // nao tem como expressar "obrigatorio se a FK apontar para produto com flag".
  lotNumber      String?
  manufacturedAt DateTime?
  expiresAt      DateTime?

  receipt   PurchaseReceipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderItem PurchaseOrderItem @relation(fields: [orderItemId], references: [id])
  product   Product           @relation(fields: [productId], references: [id])
  // F4.4: um item conferido pode ser enderecado em VARIAS posicoes.
  putaways  ReceiptPutaway[]

  @@index([receiptId])
  @@index([orderItemId])
  @@index([productId])
  @@map("purchase_receipt_items")
}

// ============================================
// NOTIFICAÇÕES
// ============================================

model Notification {
  id        String @id @default(uuid())
  userId    String
  type      String // INFO, WARNING, ERROR, SUCCESS
  category  String // PRODUCTION, STOCK, PURCHASE, QUALITY, CAPACITY
  eventType String // PRODUCTION_DELAYED, STOCK_BELOW_SAFETY, etc
  title     String
  message   String @db.Text
  data      Json? // Dados contextuais adicionais

  // Navegação
  link         String? // URL para ir direto ao recurso
  resourceType String? // ProductionOrder, Product, PurchaseOrder, etc
  resourceId   String?

  // Estado
  read       Boolean   @default(false)
  readAt     DateTime?
  archived   Boolean   @default(false)
  archivedAt DateTime?

  // Prioridade
  priority  Int       @default(1) // 1=baixa, 2=média, 3=alta, 4=crítica
  expiresAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, archived])
  @@index([category])
  @@index([eventType])
  @@index([priority])
  @@index([createdAt])
  @@index([resourceType, resourceId])
  @@map("notifications")
}

model NotificationRule {
  id        String @id @default(uuid())
  roleId    String
  eventType String // Tipo de evento que dispara a notificação

  // Configurações
  enabled     Boolean @default(true)
  minPriority Int     @default(1)

  // Canais de entrega
  inApp Boolean @default(true)
  email Boolean @default(false)

  // Condições adicionais (JSON)
  conditions Json? // Ex: { "workCenterId": "xxx", "assignedOnly": true }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, eventType])
  @@map("notification_rules")
}

model NotificationPreference {
  id       String @id @default(uuid())
  userId   String
  category String // PRODUCTION, STOCK, PURCHASE, QUALITY, CAPACITY

  // Canais habilitados por categoria
  inApp Boolean @default(true)
  email Boolean @default(false)

  // Filtros
  minPriority Int     @default(1)
  enabled     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("notification_preferences")
}

// ============================================
// MÓDULO DE CONTAGEM DE ESTOQUE
// ============================================

// F3.1 do plano do WMS: `model Location` e `enum LocationType` foram REMOVIDOS
// aqui, junto com a tabela `locations` (migration
// `20260902200000_fase3_wms_contagem_por_endereco`) e com
// `prisma/seed-locations.ts`. E a conclusao da decisao 4.1 de
// docs/fase-2026-09-modernizacao/WMS_IMPLEMENTATION_ANALYSIS.md: existe UMA
// hierarquia de endereco no sistema, `Warehouse -> WarehouseStructure ->
// StoragePosition`. A F0.6 apenas congelou o model; o drop so podia vir depois
// que `CountingItem` - sua unica FK, NULL em 100% das linhas - migrasse para
// `storagePositionId`, o que acontece nesta mesma fase.

// Plano de Contagem
model CountingPlan {
  id          String             @id @default(uuid())
  code        String             @unique
  name        String
  description String?            @db.Text
  type        CountingType
  frequency   CountingFrequency?
  status      CountingPlanStatus @default(DRAFT)

  // Critérios de seleção (JSON)
  criteria Json?

  // Configurações
  allowBlindCount  Boolean  @default(true)
  requireRecount   Boolean  @default(true)
  tolerancePercent Decimal? @db.Decimal(5, 2)
  toleranceQty     Int?
  priority         Int      @default(5)

  // Datas
  startDate     DateTime
  endDate       DateTime?
  nextExecution DateTime?

  // Responsável
  createdBy String

  // Auditoria
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  creator  User                  @relation("CountingPlanCreator", fields: [createdBy], references: [id])
  sessions CountingSession[]
  products CountingPlanProduct[]

  @@index([status, nextExecution])
  @@index([type, frequency])
  @@index([createdBy])
  @@map("counting_plans")
}

// Sessão de Contagem (Execução do plano)
model CountingSession {
  id      String        @id @default(uuid())
  code    String        @unique
  planId  String
  status  SessionStatus @default(SCHEDULED)
  // ✅ Fase 4 item 4.2: lock otimista (ver comentário em ProductionOrder)
  version Int           @default(0)

  // Datas
  scheduledDate DateTime
  startedAt     DateTime?
  completedAt   DateTime?

  // Responsáveis
  assignedTo  String?
  completedBy String?

  // Estatísticas
  totalItems      Int      @default(0)
  countedItems    Int      @default(0)
  itemsWithDiff   Int      @default(0)
  accuracyPercent Decimal? @db.Decimal(5, 2)

  // Auditoria
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  plan          CountingPlan         @relation(fields: [planId], references: [id])
  assignedUser  User?                @relation("SessionAssignedTo", fields: [assignedTo], references: [id])
  completedUser User?                @relation("SessionCompletedBy", fields: [completedBy], references: [id])
  items         CountingItem[]
  adjustments   StockMovement[]      @relation("CountingAdjustments")
  assignments   CountingAssignment[]

  @@unique([planId, scheduledDate])
  @@index([planId])
  @@index([status, scheduledDate])
  @@index([assignedTo])
  @@map("counting_sessions")
}

// Item de Contagem
model CountingItem {
  id                String  @id @default(uuid())
  sessionId         String
  productId         String
  // F3.1 do plano do WMS: `locationId` (FK para o model `Location`, congelado na
  // F0.6) virou `storagePositionId` - a unidade enderecavel atomica do WMS
  // (decisao 4.1 do WMS_IMPLEMENTATION_ANALYSIS.md). A migracao de dados foi
  // TRIVIAL porque a coluna antiga era NULL em 100% das linhas: nenhum codigo de
  // aplicacao jamais a escreveu.
  //
  // Continua OPCIONAL, e isso e deliberado - sao dois caminhos de geracao de
  // item, decididos por `isModuleEnabled('WMS')` em
  // counting-session.service.ts::buildSessionItems():
  //   WMS licenciado     -> um item por (produto x posicao com saldo), com o
  //                         endereco preenchido. Produto sem NENHUM saldo
  //                         enderecado ainda gera um item com NULL, para nao
  //                         sumir da contagem.
  //   WMS nao licenciado -> um item por produto, sempre NULL (comportamento
  //                         historico, inalterado numa instalacao so-PCP).
  storagePositionId String?
  // ✅ Fase 4 item 4.2: lock otimista - camada extra alem do lock pessimista
  // (SELECT ... FOR UPDATE) ja adicionado em count()/recount() na Fase 3;
  // esse cobre chamadas concorrentes na MESMA requisicao logica, este cobre
  // o cliente que ficou com dados desatualizados na tela por mais tempo
  version           Int     @default(0)

  // Quantidades
  systemQty  Decimal  @db.Decimal(10, 2)
  countedQty Decimal? @db.Decimal(10, 2)
  recountQty Decimal? @db.Decimal(10, 2)
  finalQty   Decimal? @db.Decimal(10, 2)

  // Divergência
  difference        Decimal? @db.Decimal(10, 2)
  differencePercent Decimal? @db.Decimal(5, 2)
  hasDifference     Boolean  @default(false)

  // Status
  status CountingItemStatus @default(PENDING)

  // Observações
  notes  String? @db.Text
  reason String? @db.Text

  // Contadores
  countedBy   String?
  countedAt   DateTime?
  recountedBy String?
  recountedAt DateTime?

  // Sequência para ordenação
  // F3.3: populado por `assignItemSequences()` para itens ENDERECADOS,
  // ordenando por warehouseCode -> streetCode -> floor -> position em rota
  // SERPENTINA (a direcao de leitura das posicoes alterna a cada andar da mesma
  // rua). Item sem endereco - o caminho so-PCP - continua com o default 0.
  sequence Int? @default(0)

  // Auditoria
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  session         CountingSession  @relation(fields: [sessionId], references: [id])
  product         Product          @relation(fields: [productId], references: [id])
  // `Restrict` EXPLICITO, mesmo padrao de StockMovement.fromPositionId/
  // toPositionId (F2.1): o default do Prisma para relacao OPCIONAL e `SetNull`,
  // que NAO serve aqui. Um item de contagem e registro historico de inventario -
  // apagar um endereco nao pode zerar silenciosamente ONDE aquela contagem
  // aconteceu. Endereco que ja foi contado se aposenta com `blocked = true`,
  // nao com DELETE.
  storagePosition StoragePosition? @relation(fields: [storagePositionId], references: [id], onDelete: Restrict)
  counter         User?            @relation("ItemCountedBy", fields: [countedBy], references: [id])
  recounter       User?            @relation("ItemRecountedBy", fields: [recountedBy], references: [id])

  @@unique([sessionId, productId, storagePositionId])
  @@index([sessionId, status])
  @@index([productId])
  @@index([hasDifference])
  @@index([countedBy])
  // Indice DEDICADO, e nao so o prefixo do unique acima: `storagePositionId` e a
  // TERCEIRA coluna do composto, entao nenhum prefixo dele responde "quais
  // contagens ja tocaram neste endereco?" (e o MySQL exige indice de suporte
  // para a FK de qualquer forma).
  @@index([storagePositionId])
  @@map("counting_items")
}

// Relação de produtos em planos de contagem
model CountingPlanProduct {
  id        String @id @default(uuid())
  planId    String
  productId String
  priority  Int    @default(0)

  plan    CountingPlan @relation(fields: [planId], references: [id])
  product Product      @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, productId])
  @@map("counting_plan_products")
}

// Atribuição de contadores a sessões
model CountingAssignment {
  id         String      @id @default(uuid())
  sessionId  String
  userId     String
  role       CounterRole
  assignedAt DateTime    @default(now())

  session CountingSession @relation(fields: [sessionId], references: [id])
  user    User            @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
  @@map("counting_assignments")
}

// Papéis de contador
enum CounterRole {
  PRIMARY // Contador principal
  SECONDARY // Recontador
  VALIDATOR // Validador final
  SUPERVISOR // Supervisor
}

// ============================================
// ENUMS - CONTAGEM DE ESTOQUE
// ============================================

// F3.1: `enum LocationType` removido junto com `model Location`. O tipo de
// endereco vivo do sistema e `PositionType`, em `StoragePosition`.

enum CountingType {
  CYCLIC
  SPOT
  FULL_INVENTORY
  BLIND
}

enum CountingFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  ON_DEMAND
}

enum CountingPlanStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CountingItemStatus {
  PENDING
  COUNTED
  RECOUNTED
  ADJUSTED
  CANCELLED
}

model Warehouse {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  legalName   String?
  document    String?
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  country     String   @default("BR")
  managerName String?
  capacity    Float?
  description String?  @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  structures WarehouseStructure[]

  @@map("warehouses")
}

model WarehouseStructure {
  id             String       @id @default(uuid())
  warehouseId    String
  streetCode     String
  floors         Int
  positions      Int
  // F0.3: campos dimensionais passaram a ser opcionais. Um tipo de AREA
  // (PISO, DOCA, QUARENTENA, BLOQUEIO, EXPEDICAO) nao tem paletizacao, entao
  // exigir peso/dimensao nao faz sentido. Continuam OBRIGATORIOS para os
  // tipos de rack - regra aplicada nos validators (Joi .when/positionType),
  // nao no banco, porque a obrigatoriedade e condicional ao tipo.
  weightCapacity Float?
  height         Float?
  width          Float?
  depth          Float?
  maxHeight      Float?
  blocked        Boolean      @default(false)
  positionType   PositionType
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id])
  storagePositions StoragePosition[]

  @@map("warehouse_structures")
}

model StoragePosition {
  id             String       @id @default(uuid())
  structureId    String
  // F0.1: endereco persistido no formato `ARM-RUA-AA-PP` (warehouseCode,
  // streetCode, floor e position com 2 digitos). Antes era concatenado em
  // memoria a cada leitura em getPositionsByStructure() - nao dava para buscar
  // por codigo, indexar nem pendurar saldo/movimento/etiqueta nele. E a unidade
  // enderecavel atomica do WMS (decisao 4.1 do WMS_IMPLEMENTATION_ANALYSIS.md).
  code           String       @unique
  warehouseCode  String
  streetCode     String
  floor          Int
  position       Int
  positionType   PositionType
  // F0.3: opcionais - ver o comentario equivalente em WarehouseStructure.
  weightCapacity Float?
  height         Float?
  width          Float?
  depth          Float?
  maxHeight      Float?
  blocked        Boolean      @default(false)
  // F0.4 (decisao D3): `occupied` foi REMOVIDO. Era uma flag denormalizada que
  // nenhum codigo jamais escrevia; mante-la seria criar uma fonte de divergencia
  // com o saldo real. Ocupacao passa a ser derivada da existencia de saldo na
  // posicao (StockPositionBalance, Fase 1).
  //
  // F4.10 (Fase 4b) - AREA DE PICKING vs. PULMAO. Ate aqui o schema nao tinha
  // como distinguir as duas coisas, e a reposicao e exatamente a regra que
  // precisa dessa distincao ("o saldo da posicao de picking caiu abaixo do
  // minimo -> traga material do pulmao").
  //
  // Um BOOLEAN, e nao um `PositionRole` enum de tres valores
  // (PICKING/PULMAO/AMBOS): a decisao de reposicao so pergunta "esta posicao e
  // de picking?" (destino) e "esta NAO e de picking?" (origem candidata). Um
  // terceiro valor nao mudaria nenhuma das duas respostas e criaria estado que
  // nenhum codigo le. Tambem NAO virou campo de `WarehouseStructure` (com
  // propagacao na geracao de posicoes): area de picking e recorte fisico do
  // endereco - e comum uma mesma rua ter o nivel do chao como picking e os
  // niveis superiores como pulmao -, entao herdar da estrutura estaria errado
  // no caso mais comum. Editavel em PUT /storage-positions/position/:id.
  isPickingArea  Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  structure             WarehouseStructure     @relation(fields: [structureId], references: [id], onDelete: Cascade)
  // F1.1/F1.2: saldo e movimentacao pendurados no endereco. Todas as relacoes
  // sao RESTRICT - ver o comentario em StockPositionBalance.
  // F2.1: a movimentacao passou a apontar para o endereco por DOIS lados
  // (origem e destino), entao sao duas back-relations nomeadas. O historico de
  // uma posicao (F2.4) e a UNIAO das duas.
  stockPositionBalances StockPositionBalance[]
  movementsFrom         StockMovement[]        @relation("StockMovementFrom")
  movementsTo           StockMovement[]        @relation("StockMovementTo")
  // F3.1: o inventario ciclico passou a contar POR ENDERECO. Tambem RESTRICT
  // (ver o comentario em CountingItem.storagePosition).
  countingItems         CountingItem[]
  // F4.1/F4.4: tarefa de armazem (origem/destino) e enderecamento de
  // recebimento. Todas RESTRICT, pelo mesmo motivo das demais.
  warehouseTasksFrom    WarehouseTask[]        @relation("WarehouseTaskFrom")
  warehouseTasksTo      WarehouseTask[]        @relation("WarehouseTaskTo")
  receiptPutaways       ReceiptPutaway[]

  @@unique([structureId, floor, position])
  @@index([warehouseCode, streetCode])
  @@index([blocked])
  // F4.10: "quais posicoes de picking existem?" - a varredura do detector de
  // reposicao. Composto com `blocked` porque posicao bloqueada nunca e
  // candidata (nem a receber reposicao, nem a fornece-la).
  @@index([isPickingArea, blocked])
  @@map("storage_positions")
}

enum PositionType {
  // Tipos de RACK - exigem peso/dimensao (paletizacao).
  PORTA_PALETES
  MINI_PORTA_PALETES
  DRIVE_IN
  DRIVE_THROUGH
  PUSH_BACK
  FLOW_RACK
  CANTILEVER
  MEZANINO
  AUTOPORTANTE
  RACKS
  CARROSSEL
  MINI_LOAD
  ESTANTES_INDUSTRIAIS
  // F0.3 - tipos de AREA (nao-rack). Cobrem o unico caso real que `Location`
  // atendia e `StoragePosition` nao (piso e area). Nao tem paletizacao, entao
  // os campos dimensionais sao opcionais para eles.
  PISO
  DOCA
  QUARENTENA
  BLOQUEIO
  EXPEDICAO
}

// ============================================
// REGRAS DE ARMAZENAGEM (WMS - Fase 4b)
// ============================================

// F4.6 do plano do WMS (WMS_IMPLEMENTATION_ANALYSIS.md, secao 5, Fase 4).
//
// Regra de SUGESTAO de endereco. Substitui a ideia de `ProductLocation`
// (endereco fixo por produto), descartada na secao 6 do plano: endereco fixo
// conflita com saldo por posicao e nao sabe responder "e se essa posicao estiver
// cheia?".
//
// ESCOPO DA REGRA - `productId` XOR `categoryId`:
//   * regra de PRODUTO ganha da regra de CATEGORIA (mais especifica);
//   * dentro do mesmo escopo, `priority` DESC decide;
//   * os dois preenchidos ao mesmo tempo, ou nenhum dos dois, e recusado em
//     `storage-rule.service.ts` e no validator Joi. A invariante NAO virou
//     CHECK constraint no banco de proposito: o Prisma 5 nao modela CHECK, e
//     uma constraint que existe no banco mas nao no `schema.prisma` e
//     exatamente o tipo de coisa que faz `prisma migrate dev` reportar drift
//     numa fase futura. E o mesmo criterio ja usado em `ReceiptPutaway`
//     (`SUM <= acceptedQty` garantido por lock, nao por constraint) e na
//     obrigatoriedade condicional de dimensao por `positionType` (validator).
//
// `positionType` NULO = "qualquer tipo de posicao serve". Nao e um filtro
// obrigatorio porque a maioria das regras reais e sobre O QUE armazenar junto
// (segregacao) e nao sobre o tipo de rack.
model StorageRule {
  id           String        @id @default(uuid())
  productId    String?
  categoryId   String?
  positionType PositionType?
  priority     Int           @default(0)

  // F4.6 - resolve o `// TODO Fase 4b` deixado em `warehouse-task.service.ts`:
  // ate aqui a tarefa de QUARENTENA era gerada SEMPRE, porque nao existia
  // nenhum lugar onde declarar que um produto/categoria exige (ou dispensa)
  // inspecao antes de enderecar. Este e esse lugar.
  //
  // Default `false` com um fallback SEGURO na ausencia de regra: sem nenhuma
  // regra aplicavel ao produto, a cadeia continua gerando QUARENTENA (o
  // comportamento da Fase 4a, inalterado para quem nao configurou nada). O
  // campo so DISPENSA a etapa quando alguem escreveu uma regra dizendo isso -
  // ou a exige quando a regra e `true` e o default do sistema mudar um dia.
  // Ver `resolveQuarantineRequirement()` em `storage-rule.service.ts`.
  requiresQuarantine Boolean @default(false)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RESTRICT explicito nas DUAS FKs opcionais, pelo mesmo motivo de
  // `WarehouseTask.fromPositionId`: o default do Prisma para relacao opcional e
  // `SetNull`, que transformaria silenciosamente uma regra de produto numa
  // regra orfa - sem escopo nenhum e, portanto, aplicavel a nada (ou, pior, a
  // tudo, dependendo de como a consulta fosse escrita).
  product  Product?         @relation(fields: [productId], references: [id], onDelete: Restrict)
  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Os dois indices que a resolucao de regra usa, na ordem em que ela consulta:
  // primeiro a regra do produto, depois a da categoria - as duas filtrando por
  // `active` e ordenando por `priority`.
  @@index([productId, active, priority])
  @@index([categoryId, active, priority])
  @@map("storage_rules")
}

// ============================================
// TAREFAS DE ARMAZEM (WMS - Fase 4a)
// ============================================

// F4.1 do plano do WMS (WMS_IMPLEMENTATION_ANALYSIS.md, secao 5, Fase 4) +
// secao 3.3 de 04_ARQUITETURA_MODULAR_LICENCIAMENTO.md.
//
// Os CINCO primeiros sao a cadeia de RECEBIMENTO (Fase 4a).
//
// Fase 4b acrescenta DOIS, e so dois: `PICKING` (F4.8 - saida de material para
// ordem de producao, com posicao de origem escolhida por FIFO) e
// `REPLENISHMENT` (F4.10 - reposicao do pulmao para a area de picking).
// `TRANSFER` e `COUNTING` continuam FORA pela mesma regra da Fase 4a: nenhum
// codigo os produz. Transferencia entre enderecos ja e um caso resolvido de
// `stock.service.ts::transfer()` (F2.3) sem tarefa nenhuma, e a contagem
// ciclica tem seu proprio ciclo de vida (`CountingSession`/`CountingItem`, Fase
// 3) - declarar os dois aqui seria enum morto no banco.
enum WarehouseTaskType {
  DESCARGA
  CONFERENCIA
  ETIQUETAGEM
  QUARENTENA
  ALOCACAO
  PICKING
  REPLENISHMENT
}

// DECISAO DE DESENHO (F4.1) - por que exatamente estes quatro valores:
//
//   PENDING     tarefa criada, ninguem comecou.
//   IN_PROGRESS alguem comecou (startedAt preenchido).
//   COMPLETED   concluida; para ALOCACAO e o momento em que o estoque entra.
//   CANCELLED   encerrada sem executar (ex.: recebimento cancelado, ou etapa
//               dispensada). Conta como RESOLVIDA para o gate de sequencia.
//
// O que NAO virou status, de proposito:
//   * `ASSIGNED` - atribuicao e ORTOGONAL ao ciclo de vida: uma tarefa pode
//     estar atribuida (`assignedTo != null`) e ainda PENDING. Fundir as duas
//     dimensoes num enum so criaria estados impossiveis de representar
//     (atribuida-e-em-andamento vs. em-andamento-sem-dono).
//   * `BLOCKED`/`FAILED` - sem caso de uso nesta fase. Uma tarefa impedida
//     continua PENDING (ninguem a concluiu) ou vira CANCELLED. Estado novo sem
//     transicao que o produza e estado morto.
enum WarehouseTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// F4.1 - unidade de trabalho rastreavel do armazem.
//
// Com WMS licenciado, o recebimento deixa de ser uma acao sincrona de tela e
// vira a cadeia DESCARGA -> CONFERENCIA -> ETIQUETAGEM -> QUARENTENA ->
// ALOCACAO (purchase-receipt.service.ts::create()). Sem WMS licenciado nenhuma
// linha desta tabela e criada e o recebimento segue linear como sempre foi.
model WarehouseTask {
  id     String              @id @default(uuid())
  type   WarehouseTaskType
  status WarehouseTaskStatus @default(PENDING)

  // Referencia POLIMORFICA, mesmo precedente de `StockMovement.reference` /
  // `referenceType` (sem FK: o alvo muda de tabela conforme o tipo da tarefa).
  // Nesta fase o unico par produzido e
  // (`reference` = PurchaseReceipt.id, `referenceType` = 'PURCHASE_RECEIPT').
  reference     String?
  // PURCHASE_RECEIPT (Fase 4a, `reference` = PurchaseReceipt.id)
  // PRODUCTION_ORDER (F4.8, `reference` = ProductionOrder.id)
  // REPLENISHMENT (F4.10, `reference` = StoragePosition.id da posicao de
  //   picking que disparou a reposicao - a tarefa nao tem documento por tras,
  //   o "documento" e o proprio endereco que ficou abaixo do minimo)
  referenceType String?

  // Posicoes de origem/destino OPCIONAIS: na cadeia de recebimento nenhuma
  // tarefa nasce com posicao. Em particular a de ALOCACAO NAO tem
  // `toPositionId` - quem aloca escolhe o endereco ao CONCLUIR a tarefa (e o
  // resultado vira `ReceiptPutaway`, que suporta mais de um endereco por item;
  // uma coluna unica aqui nem conseguiria representar isso).
  //
  // F4.8/F4.10 (Fase 4b) invertem essa assimetria, e e proposital: a tarefa de
  // PICKING nasce com `fromPositionId` JA definido (o FIFO escolhe de onde
  // tirar no momento em que a ordem e reservada; o destino e a producao, que
  // nao e endereco) e a de REPLENISHMENT nasce com os DOIS (pulmao -> picking).
  // Ou seja: na entrada o destino fica em aberto, na saida a origem ja esta
  // fechada. Sao os dois lados do mesmo principio - a posicao e definida
  // no momento em que ha informacao para decidi-la.
  // `Restrict` EXPLICITO nos dois lados - o default do Prisma para relacao
  // opcional e `SetNull`, que apagaria silenciosamente o endereco de uma
  // trilha de execucao. Mesmo motivo detalhado em `StockMovement`.
  fromPositionId String?
  toPositionId   String?

  // Opcionais porque nem toda tarefa e sobre um produto/quantidade especifica:
  // DESCARGA, CONFERENCIA, ETIQUETAGEM, QUARENTENA e ALOCACAO sao, nesta fase,
  // sobre o RECEBIMENTO INTEIRO (o detalhe por item mora em
  // PurchaseReceiptItem/ReceiptPutaway). Os campos existem para as tarefas da
  // Fase 4b (PICKING/REPLENISHMENT), que sao por produto.
  productId String?
  quantity  Decimal? @db.Decimal(18, 4) // decisao D2: quantidade nasce Decimal

  // Fase 5 — o LOTE que a tarefa movimenta. Preenchido pelo FEFO na criacao da
  // tarefa de PICKING (o mesmo momento em que `fromPositionId` e decidido: o
  // planejamento escolhe de qual endereco E de qual lote tirar) e pela
  // reposicao, que herda o lote da linha de saldo de origem. NULL para tarefa
  // de produto sem `lotTracked` e para toda a cadeia de recebimento, onde o
  // lote mora em `PurchaseReceiptItem` ate a alocacao acontecer.
  lotId     String?

  priority   Int     @default(0)
  assignedTo String?
  // Ordem de execucao dentro da cadeia do MESMO `reference`. Duas tarefas
  // podem compartilhar a mesma `sequence` (etapas paralelas); o gate de ordem
  // em warehouse-task.service.ts exige que toda tarefa de sequencia MENOR
  // esteja resolvida (COMPLETED/CANCELLED) antes de concluir esta.
  sequence   Int?
  version    Int     @default(0) // lock otimista, mesmo padrao do resto do projeto

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  fromPosition StoragePosition? @relation("WarehouseTaskFrom", fields: [fromPositionId], references: [id], onDelete: Restrict)
  toPosition   StoragePosition? @relation("WarehouseTaskTo", fields: [toPositionId], references: [id], onDelete: Restrict)
  product      Product?         @relation(fields: [productId], references: [id], onDelete: Restrict)
  assignee     User?            @relation("WarehouseTaskAssignee", fields: [assignedTo], references: [id], onDelete: Restrict)
  // `Restrict` explicito, mesmo motivo das posicoes acima.
  lot          Lot?             @relation(fields: [lotId], references: [id], onDelete: Restrict)
  putaways     ReceiptPutaway[]

  // "As tarefas deste recebimento, em ordem" - a consulta de F4.5.
  @@index([referenceType, reference])
  // "A fila do operador" e "a fila aberta do armazem" (F4.9, Fase 4b).
  @@index([assignedTo, status])
  @@index([status, priority])
  @@index([type, status])
  @@index([fromPositionId])
  @@index([toPositionId])
  @@index([productId])
  @@index([lotId])
  @@map("warehouse_tasks")
}

// F4.4 - ENDERECAMENTO de um item conferido.
//
// Tabela separada de `PurchaseReceiptItem` porque a relacao e 1:N: 100 unidades
// conferidas podem ir 60 para uma posicao e 40 para outra. Guardar um
// `storagePositionId` no proprio item so representaria o caso trivial.
//
// Invariante, validada em warehouse-task.service.ts com o item travado
// (`SELECT ... FOR UPDATE`): SUM(quantity) por item NUNCA excede
// `PurchaseReceiptItem.acceptedQty`. O banco nao tem como expressar isso
// (constraint de agregacao), entao a garantia e o lock pessimista - nao um
// read-then-write otimista.
model ReceiptPutaway {
  id                String   @id @default(uuid())
  receiptItemId     String
  storagePositionId String
  quantity          Decimal  @db.Decimal(18, 4) // decisao D2
  userId            String
  putawayAt         DateTime @default(now())
  // A tarefa de ALOCACAO que originou este enderecamento - a trilha de "quem
  // mandou guardar isso aqui". Obrigatoria: nao existe putaway sem tarefa.
  taskId            String

  // Todas as FKs sao RESTRICT (inclusive as obrigatorias, onde e o default do
  // Prisma - aqui explicito para nao depender do default): endereçamento e
  // trilha de auditoria de entrada de estoque, apagar o item de recebimento, a
  // posicao ou a tarefa por baixo nao pode evaporar essa linha. Quem precisa
  // desfazer um recebimento passa por purchase-receipt.service.ts::cancel(),
  // que estorna o estoque ANTES de apagar - nao por DELETE em cascata.
  receiptItem     PurchaseReceiptItem @relation(fields: [receiptItemId], references: [id], onDelete: Restrict)
  storagePosition StoragePosition     @relation(fields: [storagePositionId], references: [id], onDelete: Restrict)
  user            User                @relation("ReceiptPutawayUser", fields: [userId], references: [id], onDelete: Restrict)
  task            WarehouseTask       @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([receiptItemId])
  @@index([storagePositionId])
  @@index([taskId])
  @@index([userId])
  @@map("receipt_putaways")
}

// ============================================
// NUMERACAO DE DOCUMENTOS (Fase 4b - F4.7)
// ============================================

// F4.7 do plano do WMS ("qualquer numero sequencial novo, e de quebra
// `receiptNumber`, sai do padrao `count() + 1`").
//
// O QUE ESTAVA ERRADO no `count() + 1` (dois bugs, nao um):
//   1. NAO E ATOMICO. Dois recebimentos simultaneos contavam a mesma coisa e
//      geravam o MESMO `REC-2026-0007`. Como `receiptNumber` nao tem unique
//      constraint, o banco aceitava os dois e o sistema ficava com dois
//      documentos de mesmo numero - divergencia silenciosa, do tipo que so
//      aparece na conciliacao fiscal.
//   2. REAPROVEITA NUMERO. `count()` conta linhas EXISTENTES: cancelar o
//      recebimento 7 fazia o proximo nascer 7 de novo. Numero de documento nao
//      pode ser reciclado.
//
// COMO ESTA TABELA RESOLVE: `nextValue` e um contador que so ANDA PARA FRENTE,
// nunca conta linhas. O incremento e um `UPDATE ... SET nextValue = nextValue+1
// WHERE code = ?` dentro da transacao do chamador - o UPDATE pega lock
// exclusivo da linha e o segura ate o COMMIT, entao a segunda transacao
// concorrente ESPERA e le o valor ja incrementado. Nao ha janela de
// read-then-write. Ver `document-sequence.service.ts`.
//
// `code` e a PK (nao ha `id` uuid): a chave natural E o identificador, e usa-la
// como PK e o que torna o `INSERT ... ON DUPLICATE KEY UPDATE` de criacao
// preguicosa da sequencia uma operacao unica e sem corrida.
model DocumentSequence {
  // Uma sequencia por PREFIXO E ANO (`REC-2026`, `PC-2026`) - a numeracao
  // reinicia a cada ano, que e o que o formato `REC-AAAA-NNNN` ja prometia e o
  // `count()` nunca cumpriu (ele contava o historico inteiro, entao o primeiro
  // documento de 2027 nascia com o numero do ultimo de 2026 + 1).
  code      String   @id
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt

  @@map("document_sequences")
}

// ============================================
// LICENCIAMENTO DE MÓDULOS
// ============================================

// F0.8 do plano do WMS, implementando a secao 3.1 de
// docs/fase-2026-09-modernizacao/04_ARQUITETURA_MODULAR_LICENCIAMENTO.md.
//
// O modelo de deploy e UMA INSTALACAO POR CLIENTE (nao e SaaS multi-tenant
// compartilhado), entao licenciar um modulo e uma configuracao por instalacao -
// nao um filtro por tenantId espalhado pelo schema. Por isso a tabela e uma
// lista curta (PCP, WMS, YMS), lida uma vez no boot e cacheada em memoria.
//
// Duas checagens em camadas, nesta ordem por requisicao:
//   authMiddleware -> requireModule(codigo) -> requirePermission(recurso, acao)
// A INSTALACAO tem o modulo licenciado? (requireModule, novo)
// O USUARIO tem a permissao? (requirePermission, RBAC ja existente, inalterado)
//
// `PCP` nasce sempre habilitado - e o nucleo, nao e opcional, e nenhuma rota
// recebe requireModule('PCP') (seria custo sem beneficio e risco de travar o
// nucleo por erro de configuracao).
model LicensedModule {
  id        String   @id @default(uuid())
  code      String   @unique // PCP | WMS | YMS
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("licensed_modules")
}
