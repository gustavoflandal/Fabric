# Database
DATABASE_URL="mysql://fabric:fabric123@localhost:3306/fabric"

# JWT (IMPORTANTE: Gere secrets aleatórios com mínimo 32 caracteres)
# Exemplo para gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3005
NODE_ENV=development

# CORS - lista de origens permitidas separada por vírgula
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:5175"

# Audit Logs Configuration
# Tipos de logs a capturar: all, write_only, errors_only, none
AUDIT_LOG_MODE=write_only
# Se true, loga também operações GET
AUDIT_LOG_INCLUDE_READS=false
# Dias de retenção antes da limpeza automática diária (job às 2h)
AUDIT_LOG_RETENTION_DAYS=90

# SMTP - canal de email das notificações (OPCIONAL)
# Sem SMTP_HOST definido o sistema sobe normalmente e o envio de email fica em
# modo no-op (loga um aviso uma vez). O canal in-app não depende disto.
# SMTP_USER/SMTP_PASSWORD podem ficar vazios em relay interno sem autenticação.
SMTP_HOST=
# 587 = STARTTLS (padrão), 465 = TLS implícito
SMTP_PORT=587
# Se omitido, deriva da porta (true apenas para 465)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Fabric PCP <nao-responda@fabric.local>"

# WMS - janela de antecedência do alerta de validade de lote (OPCIONAL)
# Dias antes do vencimento em que o job diário das 6h passa a alertar
# (LOT_EXPIRING_SOON). Lote JÁ VENCIDO com saldo alerta sempre, independente
# deste valor (LOT_EXPIRED). Só tem efeito com o módulo WMS licenciado.
# Ausente, não numérico, zero ou negativo cai no default de 7 dias.
LOT_EXPIRY_ALERT_DAYS=7

# Assistente de IA — Fase 1 (RAG sobre manuais em PDF, OPCIONAL)
# Sem estas variáveis, os defaults assumem execução fora de container
# (localhost:11434 / localhost:8000) — útil para rodar o backend direto no
# host com `docker compose -f docker-compose.ai.yml up -d` só para os dois
# serviços de IA. Em Docker Compose completo, docker-compose.yml já
# sobrescreve os três para os nomes de serviço (ollama/chromadb).
OLLAMA_URL=http://localhost:11434
CHROMA_HOST=localhost
CHROMA_PORT=8000
ASSISTANT_CHAT_MODEL=qwen2.5:7b
ASSISTANT_EMBED_MODEL=bge-m3
ASSISTANT_NUM_CTX=4096
# Distância de cosseno máxima para um chunk ser considerado relevante
# (0=idêntico, 2=oposto) — calibrado empiricamente, ver Task 9 do plano.
ASSISTANT_MAX_COSINE_DISTANCE=0.6
