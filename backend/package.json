{
  "name": "fabric-backend",
  "version": "1.0.0",
  "description": "Fabric PCP System - Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed-production": "tsx prisma/seed-production.ts",
    "prisma:seed-stock": "tsx prisma/seed-stock-movements.ts",
    "prisma:seed-pointings": "tsx prisma/seed-pointings.ts",
    "prisma:seed-reset": "tsx prisma/seed-reset-complete.ts",
    "prisma:seed-orders-bom": "tsx prisma/seed-orders-with-bom.ts",
    "prisma:seed-purchases": "tsx prisma/seed-purchases.ts",
    "prisma:seed-notifications": "tsx prisma/seed-notifications.ts",
    "prisma:seed-counting": "tsx prisma/seed-counting.ts",
    "prisma:seed-counting-plans": "tsx prisma/seed-counting-plans.ts",
    "prisma:reset-admin-password": "tsx prisma/reset-admin-password.ts",
    "prisma:seed-all": "powershell -ExecutionPolicy Bypass -File ./seed-all.ps1",
    "backup": "tsx scripts/backup-database.ts",
    "backup:create": "tsx scripts/backup-database.ts",
    "ai:index-docs": "tsx scripts/ai-index-docs.ts",
    "test:ia": "tsx scripts/ai-golden-set.ts",
    "restore": "node restore-database.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:db:up": "docker compose -f ../docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f ../docker-compose.test.yml down -v",
    "test:db:migrate": "node ./node_modules/dotenv-cli/cli.js -e .env.test -- npx prisma migrate deploy",
    "test:db:readonly-user": "docker exec -i fabric-mysql-test mysql -u root -ptest_root_only_ephemeral fabric_test < scripts/sql/create-readonly-user.sql",
    "test:integration": "npm run test:db:up && npm run test:db:migrate && npm run test:db:readonly-user && node ./node_modules/dotenv-cli/cli.js -e .env.test -- cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "scheduler": "tsx src/jobs/counting-scheduler.ts"
  },
  "keywords": [
    "pcp",
    "mrp",
    "production",
    "manufacturing",
    "erp"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "chromadb": "^3.5.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "fast-xml-parser": "^4.5.7",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.15.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.1.1",
    "pdf-parse": "^2.4.5",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.15",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "pdfkit": "^0.20.2",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.4",
    "tsx": "^4.17.0",
    "typescript": "^5.2.2"
  }
}
