# Credenciais efemeras/descartaveis, so para o MySQL de teste local
# (docker-compose.test.yml, porta 3307, dados em tmpfs). Nunca aponta para
# um banco real - por isso pode ficar versionado (ver .gitignore).
DATABASE_URL="mysql://fabric_test:test_password_only_ephemeral@localhost:3307/fabric_test"
JWT_SECRET="test-only-jwt-secret-not-used-for-anything-real-32chars"
JWT_REFRESH_SECRET="test-only-refresh-secret-not-used-for-anything-real-32chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3002
NODE_ENV=test
AUDIT_LOG_MODE=none

# Fase 2 (assistente de IA) — usuário MySQL read-only (fabric_assistente,
# GRANT SELECT apenas nas 7 tabelas de estoque, ver
# backend/scripts/sql/create-readonly-user.sql). Mesma convenção do
# DATABASE_URL acima: credencial efêmera só para o banco de teste em tmpfs.
ASSISTANT_DATABASE_URL="mysql://fabric_assistente:assistente_test_only_ephemeral@localhost:3307/fabric_test"
